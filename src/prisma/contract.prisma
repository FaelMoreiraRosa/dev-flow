// use prisma-next
model Usuario {
  id        Int               @id @default(autoincrement())
  email     String            @unique
  nome      String
  createdAt TimestamptzString @default(now())
  projetos  Projeto[]
  senha     String
}

model Projeto {
  id        Int         @id @default(autoincrement())
  nome      String
  descrição String
  prazo     DateString?
  createdAt TimestamptzString @default(now())
  tasks     Task[]
  usuario   Usuario     @relation(fields:[userId], references:[id])
  userId    Int
}

enum Status {
  pendente
  em_andamento
  concluida
  atrasada
}

model Task {
  id        Int               @id @default(autoincrement())
  nome      String
  prazo     DateString?
  status    Status            @default(pendente)
  descrição String
  projeto   Projeto           @relation(fields:[projetoId], references:[id], onDelete: Cascade)
  projetoId Int
  createdAt TimestamptzString @default(now())
}
